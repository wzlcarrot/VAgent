# VAgent 根目录 .env.example
# 供 docker compose 使用（docker-compose.yml 读取）。用法：
#   cp .env.example .env && 编辑填入 DEEPSEEK_API_KEY
# 注意：若 shell 中已 export 过同名变量，shell 环境变量优先于 .env

# ─── LLM（必填）───
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# MiniMax（多模态/视觉，可选；不配则用 DeepSeek）
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.chat/v1
MINIMAX_MODEL=MiniMax-M3

# 主力 provider：deepseek | minimax（留空则默认 minimax，见 docker-compose.yml）
LLM_PROVIDER=
# 路由（意图分类）专用 provider，留空跟随 LLM_PROVIDER
ROUTER_LLM_PROVIDER=

# ─── 数据库（必填，禁止默认口令）───
# docker compose 会强制要求设置，禁止使用 postgres/postgres 之类的弱口令
POSTGRES_PASSWORD=replace-with-a-strong-password

# ─── 前端访问后端地址（浏览器可达）───
PUBLIC_VIDEO_URL=

# ─── 测试账户 ───
# 默认关闭（生产安全）。仅在本地/演示需要时显式开启。
# 开启后任何人可用测试账户登录，公网部署必须保持 false。
TEST_ACCOUNT_ENABLED=false
TEST_ACCOUNT_EMAIL=test@viewhub.com
TEST_ACCOUNT_PASSWORD_MD5=e10adc3949ba59abbe56e057f20f883e
TEST_ACCOUNT_USER_ID=test_user_001
TEST_ACCOUNT_NICKNAME=测试用户
TEST_ACCOUNT_AVATAR=

# ─── Agent Harness ───
HARNESS_ENABLED=true
AGENT_ASYNC_MAX_WORKERS=8

# ─── Admin API Key（/ai/admin/stats 与 /metrics 鉴权；docker compose 强制要求设置）───
ADMIN_API_KEY=replace-with-a-strong-random-key

# ─── 会话安全（HTTPS 生产环境必须 true）───
COOKIE_SECURE=false
