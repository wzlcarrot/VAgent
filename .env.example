# VAgent 根目录 .env.example
# 供 docker compose 使用（docker-compose.yml 读取）。用法：
#   cp .env.example .env && 编辑填入 DEEPSEEK_API_KEY
# 注意：若 shell 中已 export 过同名变量，shell 环境变量优先于 .env

# ─── LLM（必填）───
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ─── DeepSeek 多模态（Vision，可选）───
# deepseek-flash 支持图文输入；DEEPSEEK_VL_API_KEY 留空回退 DEEPSEEK_API_KEY
DEEPSEEK_VL_API_KEY=
DEEPSEEK_VL_BASE_URL=https://api.deepseek.com
DEEPSEEK_VL_MODEL=deepseek-flash

# 主力 provider：deepseek | deepseek-vl（留空则默认 deepseek，见 docker-compose.yml）
LLM_PROVIDER=
# 路由（意图分类）专用 provider，留空跟随 LLM_PROVIDER
ROUTER_LLM_PROVIDER=

# ─── 视频 ASR 字幕（PostgreSQL video_subtitle_segment；可选 faster-whisper）───
# ViewHub projectFolder（其下为 file/video/.../temp.mp4）
VIDEO_STORAGE_ROOT=
VIDEO_ASR_ENABLED=false
VIDEO_ASR_MODEL=tiny
VIDEO_ASR_DEVICE=cpu
VIDEO_ASR_COMPUTE_TYPE=int8
VIDEO_ASR_LANGUAGE=zh
# 字幕后处理纠错：用平台 LLM 做整体语义校对（不改 ASR 模型）；无 Key 时自动回退原文
VIDEO_ASR_CORRECT_ENABLED=true
# 纠错用的更强模型与 effort（留空用默认 provider 模型）
VIDEO_ASR_CORRECT_MODEL=deepseek-v4-pro
VIDEO_ASR_CORRECT_EFFORT=low
# RAG 精排后端：cross_encoder（本地 bge-reranker，零 token）优先，失败自动降级 llm
RAG_RERANK_BACKEND=cross_encoder
RAG_RERANK_MODEL=BAAI/bge-reranker-base
# huggingface.co 国内不可达时用镜像站（compose 内默认已设）
HF_ENDPOINT=https://hf-mirror.com

# ─── 数据库（与 ViewHub 同一只 Docker Postgres，默认 127.0.0.1:5432）───
# 本机跑 ai-end 用 127.0.0.1；compose 里的 ai-agent 会改连 host.docker.internal
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=replace-with-viewhub-pg-password
PG_DATABASE=viewhub
REDIS_PASSWORD=replace-with-a-strong-redis-password

# ─── 前端访问后端地址（浏览器可达）───
PUBLIC_VIDEO_URL=

# ─── 测试账户 ───
# 默认关闭。开启时必须自己填口令哈希，不要用 123456。
TEST_ACCOUNT_ENABLED=false
TEST_ACCOUNT_EMAIL=
TEST_ACCOUNT_PASSWORD_MD5=
TEST_ACCOUNT_USER_ID=
TEST_ACCOUNT_NICKNAME=
TEST_ACCOUNT_AVATAR=

# ─── Agent Harness ───
HARNESS_ENABLED=true
AGENT_ASYNC_MAX_WORKERS=8

# ─── Admin API Key（/ai/admin/stats 与 /metrics 鉴权；docker compose 强制要求设置）───
ADMIN_API_KEY=replace-with-a-strong-random-key

# ─── 会话安全（HTTPS 生产环境必须 true）───
COOKIE_SECURE=false
