{
  "global": {
    "default": {
      "max_calls": 10,
      "timeout_seconds": 30.0,
      "decision": "allow",
      "max_result_chars": 4000,
      "inject_user_id": false
    }
  },
  "workflows": {
    "video_qa_workflow": {
      "vector_search": { "max_calls": 5, "timeout_seconds": 10.0, "decision": "allow", "max_result_chars": 3000 },
      "retrieve_knowledge": { "max_calls": 20, "timeout_seconds": 10.0, "decision": "allow", "max_result_chars": 3000 },
      "search_video_chunks": { "max_calls": 20, "timeout_seconds": 15.0, "decision": "allow", "max_result_chars": 3500, "rules": [{ "match": { "top_k": { "gte": 50 } }, "decision": "forbidden" }] },
      "get_video_info": { "max_calls": 8, "timeout_seconds": 8.0, "decision": "allow", "max_result_chars": 2000 },
      "query_user_data": { "decision": "forbidden" },
      "recommend_videos": { "decision": "forbidden" }
    },
    "recommend_workflow": {
      "vector_search": { "max_calls": 5, "timeout_seconds": 10.0, "decision": "allow", "max_result_chars": 3000 },
      "recommend_videos": { "max_calls": 3, "timeout_seconds": 15.0, "decision": "ask", "max_result_chars": 4000, "inject_user_id": true },
      "retrieve_knowledge": { "decision": "forbidden" },
      "search_video_chunks": { "decision": "forbidden" }
    },
    "user_data_workflow": {
      "query_user_data": { "max_calls": 5, "timeout_seconds": 10.0, "decision": "allow", "inject_user_id": true },
      "user_data_query": { "max_calls": 5, "timeout_seconds": 10.0, "decision": "allow", "inject_user_id": true },
      "get_coin_count": { "max_calls": 5, "timeout_seconds": 5.0, "decision": "allow", "inject_user_id": true },
      "get_followings": { "max_calls": 5, "timeout_seconds": 8.0, "decision": "allow", "inject_user_id": true },
      "get_watch_history": { "max_calls": 5, "timeout_seconds": 8.0, "decision": "allow", "inject_user_id": true },
      "intent_classify": { "max_calls": 3, "timeout_seconds": 10.0, "decision": "allow" },
      "vector_search": { "decision": "forbidden" },
      "retrieve_knowledge": { "decision": "forbidden" },
      "search_video_chunks": { "decision": "forbidden" }
    },
    "chat_workflow": {
      "retrieve_knowledge": { "max_calls": 20, "timeout_seconds": 10.0, "decision": "allow", "max_result_chars": 3000 },
      "vector_search": { "max_calls": 5, "timeout_seconds": 10.0, "decision": "allow", "max_result_chars": 3000 },
      "retrieve_platform_docs": { "max_calls": 5, "timeout_seconds": 8.0, "decision": "allow", "max_result_chars": 3000 },
      "search_video_chunks": { "decision": "forbidden" },
      "recommend_videos": { "decision": "ask" }
    }
  }
}
