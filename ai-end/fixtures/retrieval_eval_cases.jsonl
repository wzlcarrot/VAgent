{"_corpus": [{"key": "intro_1", "video_id": "video_demo_001", "content": "本视频介绍 Python 的基础语法与编程思想，适合零基础入门。"}, {"key": "intro_2", "video_id": "video_demo_001", "content": "作者讲解了变量的定义与赋值方式。"}, {"key": "intro_3", "video_id": "video_demo_001", "content": "视频演示了 for 循环和 while 循环的用法。"}, {"key": "intro_4", "video_id": "video_demo_001", "content": "介绍了函数的定义、参数与返回值。"}, {"key": "intro_5", "video_id": "video_demo_001", "content": "讲解了列表和字典两种常用数据结构。"}, {"key": "intro_6", "video_id": "video_demo_001", "content": "演示了如何用 try except 处理异常。"}, {"key": "intro_7", "video_id": "video_demo_001", "content": "介绍了模块导入与第三方库安装。"}, {"key": "intro_8", "video_id": "video_demo_001", "content": "最后总结了学习路线与练习建议。"}, {"key": "intro_1", "video_id": "video_demo_002", "content": "本视频教大家做家常番茄炒蛋。"}, {"key": "intro_2", "video_id": "video_demo_002", "content": "第一步是把鸡蛋打散并加少许盐。"}, {"key": "intro_3", "video_id": "video_demo_002", "content": "番茄要先去皮再切块。"}, {"key": "intro_4", "video_id": "video_demo_002", "content": "火候控制是关键，油温六成热下蛋。"}, {"key": "intro_5", "video_id": "video_demo_002", "content": "翻炒时动作要快要均匀。"}, {"key": "intro_6", "video_id": "video_demo_002", "content": "最后加糖和盐调味出锅。"}, {"key": "intro_7", "video_id": "video_demo_002", "content": "常见失败原因是番茄出水太多。"}, {"key": "intro_8", "video_id": "video_demo_002", "content": "视频结尾给了搭配主食的建议。"}, {"key": "intro_1", "video_id": "video_demo_003", "content": "本视频讲解手机摄影的入门技巧。"}, {"key": "intro_2", "video_id": "video_demo_003", "content": "构图是照片好看的第一要素。"}, {"key": "intro_3", "video_id": "video_demo_003", "content": "曝光可以通过手动调节亮度来控制。"}, {"key": "intro_4", "video_id": "video_demo_003", "content": "对焦要点击屏幕主体位置。"}, {"key": "intro_5", "video_id": "video_demo_003", "content": "光线方向影响照片质感。"}, {"key": "intro_6", "video_id": "video_demo_003", "content": "介绍了几种常用的后期调色思路。"}, {"key": "intro_7", "video_id": "video_demo_003", "content": "夜景拍摄要注意防抖。"}, {"key": "intro_8", "video_id": "video_demo_003", "content": "最后推荐了练习拍摄的题材。"}]}
