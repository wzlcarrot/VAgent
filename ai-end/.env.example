# PostgreSQL
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=your-password-here
PG_DATABASE=viewhub
DB_POOL_SIZE=20

# ─── LLM Provider（二选一或都配）───
# 主 provider：deepseek | minimax
LLM_PROVIDER=deepseek
# 路由（意图分类）专用 provider：与主对话模型解耦，可留空则跟随 LLM_PROVIDER
ROUTER_LLM_PROVIDER=

# DeepSeek（必填其一）
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# MiniMax（多模态/视觉，可选）
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.chat/v1
MINIMAX_MODEL=MiniMax-M3

LLM_RETRY_MAX_ATTEMPTS=3

# ─── Redis（可选）───
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ─── Video Service (Java Backend) ───
VIDEO_SERVICE_URL=http://127.0.0.1:7071
# 给前端浏览器访问的 cover URL 前缀（公网可访问；默认等于 VIDEO_SERVICE_URL）
PUBLIC_VIDEO_URL=

# ─── CORS（逗号分隔）───
CORS_ORIGINS=http://localhost:4000,http://127.0.0.1:4000,http://localhost:4091,http://127.0.0.1:4091

# 默认关闭。开启时自己填哈希，不要用 123456。
TEST_ACCOUNT_ENABLED=false
TEST_ACCOUNT_EMAIL=
TEST_ACCOUNT_PASSWORD_MD5=
TEST_ACCOUNT_USER_ID=
TEST_ACCOUNT_NICKNAME=
TEST_ACCOUNT_AVATAR=

# ─── Context 配置 ───
CONTEXT_MAX_ROUNDS=5
CONTEXT_TTL=7200

# ─── Harness（Agent 治理）───
HARNESS_ENABLED=true
# 同步 workflow 执行线程池并发数（每请求并行 2 路，建议 ≥ 4 的倍数）
AGENT_ASYNC_MAX_WORKERS=8

# ─── Admin API Key（运营看板 /admin/stats 的鉴权；留空则端点返回 503）───
ADMIN_API_KEY=please-set-a-strong-random-key

# ─── 会话安全 ───
# HTTPS 生产环境必须设 true（httpOnly cookie 加 Secure 标志；本地 http 保持 false）
COOKIE_SECURE=false

# ─── Debug 模式 ───
DEBUG=false
